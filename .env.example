# Shared Ollama server: avoids loading a model on this low-memory VM.
OLLAMA_BASE_URL=http://100.105.206.57:11434
OLLAMA_MODEL=qwen2.5-coder:7b
CODE_ROOT=/workspace
INCIDENT_ERROR_RATE_THRESHOLD=0.10
INCIDENT_P95_MS_THRESHOLD=600

# --- Sentinel platform (controlplane) ---
# Runtime: "docker" on the server (set by deploy/docker-compose.yml), "process" for laptop development.
SENTINEL_RUNTIME=process
SENTINEL_HOME=data/sentinel
# Comma-separated sample services to deploy on first start.
SENTINEL_BOOTSTRAP=orders,inventory,payments
SENTINEL_USE_LLM=1
SENTINEL_TRAFFIC=1
# Optional LLM keys for diagnosis and patch proposals; the platform works without them.
OPENAI_API_KEY=
GROQ_API_KEY=
GRAFANA_ADMIN_PASSWORD=change-me
